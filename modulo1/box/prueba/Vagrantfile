# -*- mode: ruby -*-
# Prueba de la box publicada, equivalente al «How to use this box» de Vagrant Cloud que se ve en la clase 2.
# Vagrant lee el catálogo metadata.json desde GitHub, descarga la box de la versión publicada (release box-v0.0.1),
# comprueba su huella SHA-256 y la levanta. No monta carpetas ni recibe datos.
#
# El catálogo se sirve desde GitHub Pages y no desde raw.githubusercontent.com: Vagrant reconoce un catálogo solo si
# el servidor lo entrega con «Content-Type: application/json», y raw.githubusercontent.com entrega todo como
# «text/plain». Con text/plain, Vagrant trata el JSON como si fuera la box misma y rechaza la restricción de versión.
# GitHub Pages entrega los .json como application/json; el archivo .nojekyll de la raíz evita que Pages los procese.
#   vagrant up            descarga, verifica y levanta la box
#   vagrant ssh -c "hostnamectl; psql --version"
#   vagrant destroy -f    borra la máquina de prueba
#   vagrant box remove juanmatorreserazo/sitecali-servidor   borra la copia descargada (opcional)
Vagrant.configure("2") do |config|
  config.vm.box         = "juanmatorreserazo/sitecali-servidor"
  config.vm.box_url     = "https://juanmatorreserazo.github.io/sitecali-res-cloud/modulo1/box/metadata.json"
  config.vm.box_version = "0.0.1"
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.provider "virtualbox" do |vb|
    vb.name   = "sitecali-prueba-box"
    vb.memory = 2048
    vb.cpus   = 2
  end
end
