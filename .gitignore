# Los datos nunca entran al repositorio: ni la base, ni sus derivados, ni los paquetes internos.
datos/*
!datos/LEEME.md
*.gpkg
*.gpkg-journal
*.gpkg-wal
*.gpkg-shm
*.zip
*.tif
*.csv

# Vagrant y Python
.vagrant/
__pycache__/
*.pyc
.venv/

# Credenciales que se generan en la VM
credenciales/
*.pgpass

# Derivados regenerables del observatorio
observatorio/datos.json

# Boxes de Vagrant empaquetadas (se publican en el registro, no en Git)
*.box

# Material de referencia local: trae la base central y su documentación interna; nunca va al repositorio
00_referencia/

# Videos de sustentación: pesan demasiado para Git y se entregan por la plataforma del curso
*.mp4
*.mkv
*.mov
